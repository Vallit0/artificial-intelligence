# =============================================================================
# Cron de backups de Señoriales — cada 6 horas (00:00, 06:00, 12:00, 18:00).
#
# Instalar en capa_01:
#   chmod +x /opt/senoriales/infra/backup.sh
#   sudo cp /opt/senoriales/infra/senoriales-backup.cron /etc/cron.d/senoriales-backup
#   sudo systemctl restart cron      # recarga /etc/cron.d
#
# Formato de /etc/cron.d: incluye el campo de USUARIO (root) y debe terminar en
# salto de línea. Verás la salida en /var/log/senoriales-backup.log.
# =============================================================================
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

0 */6 * * * root /opt/senoriales/infra/backup.sh >> /var/log/senoriales-backup.log 2>&1
