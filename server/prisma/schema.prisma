generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum AppRole {
  admin
  instructor
  learner
  coach
}

enum LtiRole {
  instructor
  learner
  admin
  content_developer
}

enum MemoryCategory {
  debilidad
  fortaleza
  expresion
  comportamiento
  progreso
}

enum ExperimentStatus {
  draft
  active
  completed
}

enum PricingService {
  elevenlabs
  openai
  infra
}

enum PricingUnit {
  per_minute
  per_token_input
  per_token_output
  monthly
}

// ============================================
// Sedes (Branches / Locations)
// ============================================

// Cada usuario pertenece a exactamente una sede. El aislamiento de datos
// entre sedes es duro: un coach o admin de sede A no puede leer ni mutar
// datos de sede B. Sólo el rol `admin` global puede atravesar sedes.
//
// sedeId en User es nullable a nivel DB (para tolerar el backfill y para
// que un crash durante el seed no deje la app rota), pero la capa de
// aplicación trata sede como obligatoria: todo signup/createUser exige
// sedeId, y `requireSede` rechaza requests cuyo user no tenga sede.
model Sede {
  id        String   @id @default(uuid())
  slug      String   @unique               // "guatemala", "cdmx", "tapachula"
  name      String   @unique               // "Guatemala", "Ciudad de México"
  country   String?                        // "GT", "MX" — códigos ISO opcionales
  city      String?                        // descriptivo
  address   String?                        // dirección física opcional
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users           User[]
  ltiCourseSyncs  LtiCourseSync[]

  @@index([isActive])
  @@map("sedes")
}

// ============================================
// Users & Auth
// ============================================

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String?  @map("password_hash")
  firstName          String?  @map("first_name")
  lastName           String?  @map("last_name")
  avatarUrl          String?  @map("avatar_url")
  phoneNumber        String?  @map("phone_number")
  emailVerified      Boolean  @default(false) @map("email_verified")
  examenFinalEnabled Boolean  @default(false) @map("examen_final_enabled")
  level2Unlocked     Boolean  @default(false) @map("level2_unlocked")
  sedeId             String?  @map("sede_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  sede                Sede?                  @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  coachPermissions    CoachPermission?
  roles               UserRole[]
  refreshTokens       RefreshToken[]
  practiceSessions    PracticeSession[]
  scenarioProgress    UserScenarioProgress[]
  ltiSessions         LtiSession[]
  studentGrade        StudentGrade?          @relation("StudentGradeUser")
  gradesGiven         StudentGrade[]         @relation("GradedByUser")
  passwordResetTokens PasswordResetToken[]
  advisorMemories     AdvisorMemory[]
  sessionSummaries    SessionSummary[]
  citasAsAsesor       Cita[]                 @relation("CitaAsesor")
  citasCreated        Cita[]                 @relation("CitaCreator")

  @@index([email])
  @@index([sedeId])
  @@map("users")
}

// Permisos granulares para el rol `coach`. Existen sólo cuando el usuario
// tiene rol coach; los toggles los maneja un admin desde el panel.
// Modelados aparte (en vez de columnas en User) porque sólo aplican a
// coaches — ensuciarían User con campos null para learners/admins.
model CoachPermission {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  canCreateCoaches Boolean  @default(false) @map("can_create_coaches")
  canEditPrompts   Boolean  @default(false) @map("can_edit_prompts")
  grantedBy        String?  @map("granted_by")   // userId del admin que otorgó
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coach_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// ============================================
// LTI (Moodle Integration)
// ============================================

model LtiPlatform {
  id            String   @id @default(uuid())
  name          String
  issuerUrl     String   @unique @map("issuer_url")
  clientId      String   @map("client_id")
  authEndpoint  String   @map("auth_endpoint")
  tokenEndpoint String   @map("token_endpoint")
  jwksUrl       String   @map("jwks_url")
  deploymentId  String   @map("deployment_id")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sessions          LtiSession[]
  courseSyncs       LtiCourseSync[]
  deepLinkingStates LtiDeepLinkingState[]

  @@index([issuerUrl])
  @@map("lti_platforms")
}

model LtiSession {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  platformId         String    @map("platform_id")
  ltiUserId          String    @map("lti_user_id")
  ltiEmail           String?   @map("lti_email")
  ltiName            String?   @map("lti_name")
  contextId          String?   @map("context_id")
  contextTitle       String?   @map("context_title")
  resourceLinkId     String?   @map("resource_link_id")
  roles              LtiRole[] @default([])
  // AGS (Assignment & Grade Services) endpoint claim, captured per launch.
  // agsLineitemUrl is set when Moodle launches against a specific gradable
  // activity; agsLineitemsUrl is the collection used to discover/create
  // line items when the activity has no fixed lineitem yet. Either may be
  // null for resource links the teacher has not gradable.
  agsLineitemUrl     String?   @map("ags_lineitem_url")
  agsLineitemsUrl    String?   @map("ags_lineitems_url")
  agsScopes          String[]  @default([]) @map("ags_scopes")
  // NRPS (Names and Role Provisioning Services) endpoint claim. Captured at
  // launch time so the periodic roster sync can resolve which course this
  // user came from without depending on a separately-registered course
  // entry. When the same context_id appears in multiple sessions we keep
  // them all; the LtiCourseSync row is the canonical source of truth used
  // by the cron.
  nrpsMembershipsUrl String?   @map("nrps_memberships_url")
  lastLaunchAt       DateTime  @default(now()) @map("last_launch_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, ltiUserId])
  @@index([userId])
  @@index([platformId, ltiUserId])
  @@map("lti_sessions")
}

// RSA keypair the tool uses to sign client_assertion JWTs (token grants
// against AGS/NRPS) and Deep Linking responses. Public half is exposed at
// /lti/jwks; private half is stored encrypted with a key derived from
// JWT_SECRET via HKDF. Keep at most one active key; rotate by inserting a
// new active key and deactivating the old one (old kid stays serveable for
// in-flight tokens until cleanup).
model ToolKey {
  id            String    @id @default(uuid())
  kid           String    @unique
  algorithm     String    @default("RS256")
  publicKeyPem  String    @map("public_key_pem")
  privateKeyEnc String    @map("private_key_enc")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  rotatedAt     DateTime? @map("rotated_at")

  @@index([isActive])
  @@map("tool_keys")
}

// A Moodle course (LTI context) registered for periodic roster sync via
// NRPS. The cron iterates active rows, calls {membershipsUrl}, and runs
// the cascading match (email → normalized name) against `users`. The
// lineitemUrl is captured here so AGS pushes from web-only logins (where
// the user never did an LTI launch) still know which gradebook column to
// hit. Both URLs come from the LTI launch claims; an admin can also
// register a course manually if a teacher launches before sync runs.
model LtiCourseSync {
  id             String    @id @default(uuid())
  platformId     String    @map("platform_id")
  contextId      String    @map("context_id")
  contextTitle   String?   @map("context_title")
  membershipsUrl String    @map("memberships_url")
  // Defaulting lineitem for users who never launched: the practice/exam
  // they take from the web posts here. Optional because some courses are
  // pure roster sync (no grading) and because the value is only known
  // after a teacher has bound the tool to a gradable activity.
  lineitemUrl    String?   @map("lineitem_url")
  // Sede asignada a los usuarios auto-creados por NRPS sync. Si es null,
  // el servicio de sync usa la primera sede activa como fallback. El
  // admin la setea explícitamente desde el panel cuando un curso de
  // Moodle corresponde a una sede específica.
  defaultSedeId  String?   @map("default_sede_id")
  isActive       Boolean   @default(true) @map("is_active")
  lastSyncedAt   DateTime? @map("last_synced_at")
  lastSyncStatus String?   @map("last_sync_status")
  lastSyncError  String?   @map("last_sync_error")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  platform       LtiPlatform       @relation(fields: [platformId], references: [id], onDelete: Cascade)
  defaultSede    Sede?             @relation(fields: [defaultSedeId], references: [id], onDelete: SetNull)
  pendingMatches LtiPendingMatch[]

  @@unique([platformId, contextId])
  @@index([isActive])
  @@map("lti_course_syncs")
}

// Roster entries the cascading matcher could not unambiguously resolve.
// Today this is exclusively the "name match returned 2+ candidates"
// branch — email matches always succeed unambiguously (email is unique
// on users), and no-match cases auto-create. Admin resolves manually:
// either picks one of the candidates or marks the row dismissed.
model LtiPendingMatch {
  id               String    @id @default(uuid())
  courseSyncId     String    @map("course_sync_id")
  ltiUserId        String    @map("lti_user_id")
  ltiEmail         String?   @map("lti_email")
  ltiName          String?   @map("lti_name")
  candidateUserIds String[]  @default([]) @map("candidate_user_ids")
  reason           String // "ambiguous_name" today; reserved for future variants
  resolvedAt       DateTime? @map("resolved_at")
  resolvedUserId   String?   @map("resolved_user_id")
  dismissedAt      DateTime? @map("dismissed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  courseSync LtiCourseSync @relation(fields: [courseSyncId], references: [id], onDelete: Cascade)

  @@unique([courseSyncId, ltiUserId])
  @@index([resolvedAt])
  @@map("lti_pending_matches")
}

// One-time-use launch state for OIDC Login Initiation. Persisted at
// /lti/initiate and consumed at /lti/launch — closes the CSRF/replay window
// (without this, a stolen launch URL could be replayed). Rows TTL via
// expiresAt (10 minutes) and are deleted on consumption.
model LtiLaunchState {
  state      String   @id
  nonce      String
  platformId String   @map("platform_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("lti_launch_states")
}

// Deep Linking 1.3 — short-lived handoff between the launch (where Moodle
// sent us a LtiDeepLinkingRequest with the return URL) and the picker UI
// (where the teacher chooses which scenarios to embed). The picker reads
// this row to know which scenarios to show, and POSTs the selection back
// against the same id; the submit endpoint signs the LtiDeepLinkingResponse
// JWT and returns an auto-submit form pointed at returnUrl. Single-use:
// consumedAt is set on submit so the same picker URL cannot be replayed
// to register another activity.
model LtiDeepLinkingState {
  id            String    @id @default(uuid())
  platformId    String    @map("platform_id")
  deploymentId  String    @map("deployment_id")
  returnUrl     String    @map("return_url")
  data          String?   // opaque "data" field from the request, echoed back per spec
  ltiUserId     String    @map("lti_user_id")
  contextId     String?   @map("context_id")
  contextTitle  String?   @map("context_title")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  platform LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("lti_deep_linking_states")
}

// ============================================
// Scenarios & Practice
// ============================================

model Scenario {
  id            String   @id @default(uuid())
  name          String
  description   String?
  objection     String
  clientPersona String   @map("client_persona")
  firstMessage  String?  @map("first_message")
  voiceType     String   @default("female") @map("voice_type")
  difficulty    String   @default("medium")
  scriptContent Json?    @map("script_content")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  practiceSessions PracticeSession[]
  userProgress     UserScenarioProgress[]
  sessionSummaries SessionSummary[]

  @@index([isActive, displayOrder])
  @@map("scenarios")
}

model PracticeSession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  scenarioId      String?  @map("scenario_id")
  durationSeconds Int      @default(0) @map("duration_seconds")
  score           Int?
  passed          Boolean  @default(false)
  rating          Int?
  aiFeedback      String?  @map("ai_feedback")
  transcript      Json?
  abVariantId     String?  @map("ab_variant_id")
  connectMs       Int?     @map("connect_ms")
  ttfaSamplesMs   Int[]    @default([]) @map("ttfa_samples_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario            Scenario?            @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  sessionSummary      SessionSummary?
  evaluationBreakdown EvaluationBreakdown?

  @@index([userId, createdAt(sort: Desc)])
  @@index([scenarioId])
  @@index([abVariantId])
  @@map("practice_sessions")
}

model EvaluationBreakdown {
  id               String   @id @default(uuid())
  sessionId        String   @unique @map("session_id")
  apertura         Int      @default(0)
  escuchaActiva    Int      @default(0) @map("escucha_activa")
  manejoObjeciones Int      @default(0) @map("manejo_objeciones")
  propuestaValor   Int      @default(0) @map("propuesta_valor")
  cierre           Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("evaluation_breakdowns")
}

model UserScenarioProgress {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  scenarioId       String    @map("scenario_id")
  isUnlocked       Boolean   @default(false) @map("is_unlocked")
  isCompleted      Boolean   @default(false) @map("is_completed")
  bestScore        Int?      @map("best_score")
  attempts         Int       @default(0)
  firstCompletedAt DateTime? @map("first_completed_at")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
  @@index([userId])
  @@map("user_scenario_progress")
}

// ============================================
// Grading & Certificates
// ============================================

model StudentGrade {
  id                     String    @id @default(uuid())
  userId                 String    @unique @map("user_id")
  gradedBy               String?   @map("graded_by")
  finalGrade             Decimal   @map("final_grade") @db.Decimal(5, 2)
  notes                  String?
  certificateGeneratedAt DateTime? @map("certificate_generated_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  user   User  @relation("StudentGradeUser", fields: [userId], references: [id], onDelete: Cascade)
  grader User? @relation("GradedByUser", fields: [gradedBy], references: [id], onDelete: SetNull)

  @@map("student_grades")
}

// ============================================
// Advisor Memory System
// ============================================

model AdvisorMemory {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  content    String
  category   MemoryCategory
  importance Int            @default(5)
  source     String? // "agent" | "summary" | "manual"
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, importance(sort: Desc)])
  @@index([userId, category])
  @@map("advisor_memories")
}

model SessionSummary {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  sessionId       String   @unique @map("session_id")
  scenarioId      String?  @map("scenario_id")
  summary         String
  score           Int?
  strengths       String[] // detected strengths
  weaknesses      String[] // detected weaknesses
  recommendation  String? // what to practice next
  durationSeconds Int      @default(0) @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session  PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scenario Scenario?       @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("session_summaries")
}

// ============================================
// Coach Center - Citas (Appointments)
// ============================================

enum CitaTipo {
  presencial
  virtual
  telefonica
}

enum CitaPrioridad {
  alta
  media
  baja
}

model Cita {
  id         String        @id @default(uuid())
  director   String
  asesorId   String        @map("asesor_id")
  asesorName String        @map("asesor_name")
  cliente    String
  municipio  String
  ciudad     String
  zona       String
  fecha      DateTime
  horaInicio String        @map("hora_inicio") // "08:00", "09:00", etc.
  tipo       CitaTipo      @default(presencial)
  prioridad  CitaPrioridad @default(media)
  linkSala   String?       @map("link_sala")
  notas      String?
  createdBy  String        @map("created_by")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")

  asesor  User @relation("CitaAsesor", fields: [asesorId], references: [id], onDelete: Cascade)
  creator User @relation("CitaCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([asesorId])
  @@index([director])
  @@index([fecha])
  @@map("citas")
}

// ============================================
// Agent Configuration (ElevenLabs)
// ============================================

model AgentConfig {
  id         String   @id @default(uuid())
  secretName String   @unique @map("secret_name")
  agentId    String   @map("agent_id")
  label      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("agent_configs")
}

// ============================================
// Prospecting Scenarios Configuration
// ============================================

model ProspectingScenarioConfig {
  id             String   @id @default(uuid())
  secretName     String   @unique @map("secret_name")
  label          String?
  systemPrompt   String?  @map("system_prompt")
  firstMessage   String?  @map("first_message")
  isActiveGlobal Boolean  @default(true) @map("is_active_global")
  builderParams  Json?    @map("builder_params")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("prospecting_scenario_configs")
}

model UserScenarioAccess {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  secretName String   @map("secret_name")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, secretName])
  @@index([userId])
  @@map("user_scenario_access")
}

// ============================================
// A/B Testing
// ============================================

model AbExperiment {
  id              String           @id @default(uuid())
  name            String
  description     String?
  agentSecretName String           @map("agent_secret_name")
  status          ExperimentStatus @default(draft)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")

  variants    AbVariant[]
  assignments AbAssignment[]

  @@index([status])
  @@map("ab_experiments")
}

model AbVariant {
  id           String  @id @default(uuid())
  experimentId String  @map("experiment_id")
  name         String
  systemPrompt String? @map("system_prompt")
  firstMessage String? @map("first_message")
  weight       Int     @default(1)

  experiment  AbExperiment   @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  assignments AbAssignment[]

  @@index([experimentId])
  @@map("ab_variants")
}

model AbAssignment {
  id           String   @id @default(uuid())
  experimentId String   @map("experiment_id")
  variantId    String   @map("variant_id")
  userId       String   @map("user_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  experiment AbExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant    AbVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, userId])
  @@index([userId])
  @@map("ab_assignments")
}

// ============================================
// Pricing Rates (cost analytics)
// ============================================

// Tarifas de servicios externos para estimar costos en el panel de Analíticas.
// Historial inmutable: cuando se actualiza una tarifa se inserta una fila nueva
// con effectiveFrom=now() y se cierra la anterior con effectiveTo=now(). La
// tarifa "vigente" es la fila con isActive=true cuyo rango cubre el instante.
model PricingRate {
  id            String         @id @default(uuid())
  service       PricingService
  unit          PricingUnit
  unitPriceUsd  Decimal        @map("unit_price_usd") @db.Decimal(12, 6)
  currency      String         @default("USD")
  effectiveFrom DateTime       @default(now()) @map("effective_from")
  effectiveTo   DateTime?      @map("effective_to")
  isActive      Boolean        @default(true) @map("is_active")
  notes         String?
  createdBy     String?        @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([service, unit, isActive])
  @@index([effectiveFrom])
  @@map("pricing_rates")
}
