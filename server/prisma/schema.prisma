generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum AppRole {
  admin
  instructor
  learner
  coach
}

enum MemoryCategory {
  debilidad
  fortaleza
  expresion
  comportamiento
  progreso
}

enum ExperimentStatus {
  draft
  active
  completed
}

// Estado de la cuenta en el flujo de auto-registro con aprobación.
// pending: el usuario se registró y espera el visto bueno de un admin
// global o del coach de su sede. approved: puede iniciar sesión.
// rejected: el registro fue rechazado (no puede entrar; se le notifica).
enum AccountStatus {
  pending
  approved
  rejected
}

enum PricingService {
  elevenlabs
  openai
  infra
}

enum PricingUnit {
  per_minute
  per_token_input
  per_token_output
  monthly
}

// ============================================
// Sedes (Branches / Locations)
// ============================================

// Cada usuario pertenece a exactamente una sede. El aislamiento de datos
// entre sedes es duro: un coach o admin de sede A no puede leer ni mutar
// datos de sede B. Sólo el rol `admin` global puede atravesar sedes.
//
// sedeId en User es nullable a nivel DB (para tolerar el backfill y para
// que un crash durante el seed no deje la app rota), pero la capa de
// aplicación trata sede como obligatoria: todo signup/createUser exige
// sedeId, y `requireSede` rechaza requests cuyo user no tenga sede.
model Sede {
  id        String   @id @default(uuid())
  slug      String   @unique               // "guatemala", "cdmx", "tapachula"
  name      String   @unique               // "Guatemala", "Ciudad de México"
  country   String?                        // "GT", "MX" — códigos ISO opcionales
  city      String?                        // descriptivo
  address   String?                        // dirección física opcional
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users     User[]
  divisions Division[]

  @@index([isActive])
  @@map("sedes")
}

// ============================================
// Divisiones (Divisions)
// ============================================
//
// Nivel organizativo intermedio dentro de una Sede: una Sede tiene varias
// Divisiones y cada División tiene UN coach a cargo. Los estudiantes se
// asignan a una División y heredan el coach de esa división — `User.coachId`
// se mantiene como campo denormalizado/sincronizado desde la división para
// no romper el código existente (calificaciones, sidebar, /auth/me).
model Division {
  id        String   @id @default(uuid())
  name      String
  sedeId    String   @map("sede_id")
  // Coach a cargo (User con rol coach de la MISMA sede). Nullable para poder
  // crear la división antes de asignarle coach; al borrar el coach,
  // onDelete: SetNull deja la división sin coach en vez de bloquear.
  coachId   String?  @map("coach_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sede     Sede   @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  coach    User?  @relation("DivisionCoach", fields: [coachId], references: [id], onDelete: SetNull)
  learners User[] @relation("DivisionLearners")

  @@unique([sedeId, name])
  @@index([sedeId])
  @@index([coachId])
  @@map("divisions")
}

// ============================================
// Users & Auth
// ============================================

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String?  @map("password_hash")
  firstName          String?  @map("first_name")
  lastName           String?  @map("last_name")
  avatarUrl          String?  @map("avatar_url")
  phoneNumber        String?  @map("phone_number")
  emailVerified      Boolean  @default(false) @map("email_verified")
  // Gatea el examen final de Prospección (Nivel 1). Lo habilita un admin global
  // (cualquier estudiante) o un coach (sólo sus estudiantes asignados).
  examenFinalEnabled Boolean  @default(false) @map("examen_final_enabled")
  // Gatea el examen final de Objeciones (Nivel 2). Mismo control que Prospección.
  // Default false = bloqueado para todos hasta que admin/coach lo habilite.
  examenObjecionesEnabled Boolean @default(false) @map("examen_objeciones_enabled")
  // Bypass del tiempo mínimo de práctica requerido para rendir los exámenes
  // (min_practice_seconds_* de AppConfig). Pensado para QA/testing: permite a un
  // estudiante puntual rendir el examen SIN haber acumulado los minutos de
  // práctica. NO otorga acceso al examen por sí solo (eso lo dan los
  // examen*Enabled); sólo salta el gate de tiempo de práctica. Default false.
  examPracticeBypass Boolean  @default(false) @map("exam_practice_bypass")
  level2Unlocked     Boolean  @default(false) @map("level2_unlocked")
  // Se marca al aprobar el examen final de Nivel 2 (Manejo de Objeciones).
  // Habilita la descarga del certificado de finalización del programa.
  courseCompleted    Boolean  @default(false) @map("course_completed")
  // Se marca al terminar (o saltar) el tour guiado del primer login. Mientras
  // sea false, /practice dispara el onboarding tour. Default false para todos,
  // así los usuarios existentes lo ven como reintroducción a la plataforma.
  tutorialCompleted  Boolean  @default(false) @map("tutorial_completed")
  // Flujo de auto-registro con aprobación. Los usuarios que se auto-registran
  // nacen `pending` y no pueden iniciar sesión hasta que un admin global o el
  // coach de su sede los apruebe. Los usuarios creados desde el panel admin se
  // crean directamente `approved`. La migración hace backfill = approved para
  // todos los usuarios preexistentes (eran de antes de este flujo).
  status             AccountStatus @default(pending)
  approvedBy         String?  @map("approved_by")      // userId del aprobador
  approvedAt         DateTime? @map("approved_at")
  rejectedReason     String?  @map("rejected_reason")  // motivo opcional (rechazo)
  sedeId             String?  @map("sede_id")
  // Coach asignado (auto-relación). DENORMALIZADO: la fuente de verdad es
  // `divisionId` — el coach se sincroniza desde el coach de la división del
  // learner. Se conserva porque está cableado en calificaciones, sidebar,
  // /auth/me y la relación `learners`. Al borrar el coach, onDelete: SetNull
  // desasigna a sus alumnos en lugar de bloquear.
  coachId            String?  @map("coach_id")
  // División a la que pertenece el learner (de su misma sede). Fuente de
  // verdad de la asignación; el coach se deriva de la división.
  divisionId         String?  @map("division_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  sede                Sede?                  @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  coach               User?                  @relation("CoachLearners", fields: [coachId], references: [id], onDelete: SetNull)
  learners            User[]                 @relation("CoachLearners")
  division            Division?              @relation("DivisionLearners", fields: [divisionId], references: [id], onDelete: SetNull)
  divisionsCoached    Division[]             @relation("DivisionCoach")
  coachPermissions    CoachPermission?
  roles               UserRole[]
  refreshTokens       RefreshToken[]
  practiceSessions    PracticeSession[]
  scenarioProgress    UserScenarioProgress[]
  studentGrade        StudentGrade?          @relation("StudentGradeUser")
  gradesGiven         StudentGrade[]         @relation("GradedByUser")
  passwordResetTokens PasswordResetToken[]
  advisorMemories     AdvisorMemory[]
  sessionSummaries    SessionSummary[]
  citasAsAsesor       Cita[]                 @relation("CitaAsesor")
  citasCreated        Cita[]                 @relation("CitaCreator")

  @@index([email])
  @@index([sedeId])
  @@index([coachId])
  @@index([divisionId])
  @@index([status])
  @@map("users")
}

// Permisos granulares para el rol `coach`. Existen sólo cuando el usuario
// tiene rol coach; los toggles los maneja un admin desde el panel.
// Modelados aparte (en vez de columnas en User) porque sólo aplican a
// coaches — ensuciarían User con campos null para learners/admins.
model CoachPermission {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  canCreateCoaches Boolean  @default(false) @map("can_create_coaches")
  canEditPrompts   Boolean  @default(false) @map("can_edit_prompts")
  // Da acceso al panel de administrador COMPLETO y GLOBAL (atraviesa sedes,
  // como un admin). Lo otorga sólo un admin global desde la pantalla de Coaches.
  canAccessAdmin   Boolean  @default(false) @map("can_access_admin")
  grantedBy        String?  @map("granted_by")   // userId del admin que otorgó
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coach_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

// ============================================
// Scenarios & Practice
// ============================================

model Scenario {
  id            String   @id @default(uuid())
  name          String
  description   String?
  objection     String
  clientPersona String   @map("client_persona")
  firstMessage  String?  @map("first_message")
  voiceType     String   @default("female") @map("voice_type")
  difficulty    String   @default("medium")
  scriptContent Json?    @map("script_content")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  practiceSessions PracticeSession[]
  userProgress     UserScenarioProgress[]
  sessionSummaries SessionSummary[]

  @@index([isActive, displayOrder])
  @@map("scenarios")
}

model PracticeSession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  scenarioId      String?  @map("scenario_id")
  // null = práctica normal; 'prospeccion' = Examen Final de Prospección
  // (Nivel 1); 'objeciones' = Examen Final de Manejo de Objeciones (Nivel 2).
  // Distingue los dos exámenes, que ambos corren con scenarioId == null, para
  // gradear/trackear/reportar por separado.
  examType        String?  @map("exam_type")
  // Modo de práctica con el que corrió la sesión. Se fija al crear la sesión y
  // permite desglosar el tiempo de práctica por modo en analítica (el examType
  // sólo cubre los dos exámenes finales). Valores: 'cliente',
  // 'cliente_prospeccion' (sub-modo de Cliente), 'asesor', 'objeciones',
  // 'coach'. null = sesiones previas a esta feature (Sin clasificar).
  practiceMode    String?  @map("practice_mode")
  durationSeconds Int      @default(0) @map("duration_seconds")
  score           Int?
  passed          Boolean  @default(false)
  rating          Int?
  aiFeedback      String?  @map("ai_feedback")
  transcript      Json?
  abVariantId     String?  @map("ab_variant_id")
  connectMs       Int?     @map("connect_ms")
  ttfaSamplesMs   Int[]    @default([]) @map("ttfa_samples_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario            Scenario?            @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  sessionSummary      SessionSummary?
  evaluationBreakdown EvaluationBreakdown?

  @@index([userId, createdAt(sort: Desc)])
  @@index([scenarioId])
  @@index([abVariantId])
  @@index([practiceMode])
  @@map("practice_sessions")
}

model EvaluationBreakdown {
  id               String   @id @default(uuid())
  sessionId        String   @unique @map("session_id")
  apertura         Int      @default(0)
  escuchaActiva    Int      @default(0) @map("escucha_activa")
  manejoObjeciones Int      @default(0) @map("manejo_objeciones")
  propuestaValor   Int      @default(0) @map("propuesta_valor")
  cierre           Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("evaluation_breakdowns")
}

model UserScenarioProgress {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  scenarioId       String    @map("scenario_id")
  isUnlocked       Boolean   @default(false) @map("is_unlocked")
  isCompleted      Boolean   @default(false) @map("is_completed")
  bestScore        Int?      @map("best_score")
  attempts         Int       @default(0)
  firstCompletedAt DateTime? @map("first_completed_at")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
  @@index([userId])
  @@map("user_scenario_progress")
}

// ============================================
// Grading & Certificates
// ============================================

model StudentGrade {
  id                     String    @id @default(uuid())
  userId                 String    @unique @map("user_id")
  gradedBy               String?   @map("graded_by")
  finalGrade             Decimal   @map("final_grade") @db.Decimal(5, 2)
  notes                  String?
  certificateGeneratedAt DateTime? @map("certificate_generated_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  user   User  @relation("StudentGradeUser", fields: [userId], references: [id], onDelete: Cascade)
  grader User? @relation("GradedByUser", fields: [gradedBy], references: [id], onDelete: SetNull)

  @@map("student_grades")
}

// ============================================
// Advisor Memory System
// ============================================

model AdvisorMemory {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  content    String
  category   MemoryCategory
  importance Int            @default(5)
  source     String? // "agent" | "summary" | "manual"
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, importance(sort: Desc)])
  @@index([userId, category])
  @@map("advisor_memories")
}

model SessionSummary {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  sessionId       String   @unique @map("session_id")
  scenarioId      String?  @map("scenario_id")
  summary         String
  score           Int?
  strengths       String[] // detected strengths
  weaknesses      String[] // detected weaknesses
  recommendation  String? // what to practice next
  durationSeconds Int      @default(0) @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session  PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scenario Scenario?       @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("session_summaries")
}

// ============================================
// Coach Center - Citas (Appointments)
// ============================================

enum CitaTipo {
  presencial
  virtual
  telefonica
}

enum CitaPrioridad {
  alta
  media
  baja
}

model Cita {
  id         String        @id @default(uuid())
  director   String
  asesorId   String        @map("asesor_id")
  asesorName String        @map("asesor_name")
  cliente    String
  municipio  String
  ciudad     String
  zona       String
  fecha      DateTime
  horaInicio String        @map("hora_inicio") // "08:00", "09:00", etc.
  tipo       CitaTipo      @default(presencial)
  prioridad  CitaPrioridad @default(media)
  linkSala   String?       @map("link_sala")
  notas      String?
  createdBy  String        @map("created_by")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at")

  asesor  User @relation("CitaAsesor", fields: [asesorId], references: [id], onDelete: Cascade)
  creator User @relation("CitaCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([asesorId])
  @@index([director])
  @@index([fecha])
  @@map("citas")
}

// ============================================
// Agent Configuration (ElevenLabs)
// ============================================

model AgentConfig {
  id         String   @id @default(uuid())
  secretName String   @unique @map("secret_name")
  agentId    String   @map("agent_id")
  label      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("agent_configs")
}

// ============================================
// Prospecting Scenarios Configuration
// ============================================

model ProspectingScenarioConfig {
  id             String   @id @default(uuid())
  secretName     String   @unique @map("secret_name")
  label          String?
  // Texto descriptivo y video de preview que ve el alumno en el carrusel.
  // Cuando son null, el carrusel cae al valor por defecto definido en código
  // (prospectingScenarios en ProspectingCarousel.tsx). Sólo aplican a los
  // escenarios de prospección; los agentes de Nivel 1/2 los ignoran.
  description    String?
  videoUrl       String?  @map("video_url")
  // Ubicación (insignia con el pin) y edad objetivo que ve el alumno en la
  // tarjeta. Igual que los demás campos de display: null = usa el valor por
  // defecto en código y sólo aplican a escenarios de prospección.
  location       String?
  targetAge      String?  @map("target_age")
  systemPrompt   String?  @map("system_prompt")
  firstMessage   String?  @map("first_message")
  isActiveGlobal Boolean  @default(true) @map("is_active_global")
  builderParams  Json?    @map("builder_params")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("prospecting_scenario_configs")
}

// Configuración global de la plataforma, editable por el admin. Fila única
// (singleton, id="singleton"). Los valores tienen defaults que replican los que
// antes estaban fijos en código, así que ausencia de fila = comportamiento previo.
model AppConfig {
  id                         String   @id @default("singleton")
  // Duración máxima de llamada por módulo, en segundos.
  callDurationProspeccionSec Int      @default(300) @map("call_duration_prospeccion_sec")
  callDurationObjecionesSec  Int      @default(600) @map("call_duration_objeciones_sec")
  // Umbral de aprobación (0-100) por examen.
  passThresholdProspeccion   Int      @default(75) @map("pass_threshold_prospeccion")
  passThresholdObjeciones    Int      @default(80) @map("pass_threshold_objeciones")
  // Tiempo mínimo de PRÁCTICA (en segundos) que un estudiante debe acumular
  // antes de poder rendir cada examen. 0 = sin requisito (comportamiento
  // histórico). Sólo cuenta tiempo de práctica del nivel, no intentos de examen.
  minPracticeSecondsProspeccion Int   @default(0) @map("min_practice_seconds_prospeccion")
  minPracticeSecondsObjeciones  Int   @default(0) @map("min_practice_seconds_objeciones")
  // Datos del certificado de NIVEL 2 / Objeciones (vacío = línea sin nombre, como
  // hoy). Históricamente era el único certificado, por eso conserva el prefijo
  // `certificate*` sin sufijo de nivel para no romper compatibilidad.
  certificateInstructorName  String?  @map("certificate_instructor_name")
  certificateDirectorName    String?  @map("certificate_director_name")
  certificateCourseName      String?  @map("certificate_course_name")
  // Datos del certificado de NIVEL 1 / Prospección.
  certificateLevel1InstructorName String? @map("certificate_level1_instructor_name")
  certificateLevel1DirectorName   String? @map("certificate_level1_director_name")
  certificateLevel1CourseName     String? @map("certificate_level1_course_name")
  // Firma manuscrita (imagen) de cada firmante, guardada como data URI base64
  // (data:image/png;base64,...). Vacío = sólo la línea de firma, como hoy.
  certificateInstructorSignature       String? @map("certificate_instructor_signature")
  certificateDirectorSignature         String? @map("certificate_director_signature")
  certificateLevel1InstructorSignature String? @map("certificate_level1_instructor_signature")
  certificateLevel1DirectorSignature   String? @map("certificate_level1_director_signature")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_config")
}

model UserScenarioAccess {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  secretName String   @map("secret_name")
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, secretName])
  @@index([userId])
  @@map("user_scenario_access")
}

// ============================================
// A/B Testing
// ============================================

model AbExperiment {
  id              String           @id @default(uuid())
  name            String
  description     String?
  agentSecretName String           @map("agent_secret_name")
  status          ExperimentStatus @default(draft)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")

  variants    AbVariant[]
  assignments AbAssignment[]

  @@index([status])
  @@map("ab_experiments")
}

model AbVariant {
  id           String  @id @default(uuid())
  experimentId String  @map("experiment_id")
  name         String
  systemPrompt String? @map("system_prompt")
  firstMessage String? @map("first_message")
  weight       Int     @default(1)

  experiment  AbExperiment   @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  assignments AbAssignment[]

  @@index([experimentId])
  @@map("ab_variants")
}

model AbAssignment {
  id           String   @id @default(uuid())
  experimentId String   @map("experiment_id")
  variantId    String   @map("variant_id")
  userId       String   @map("user_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  experiment AbExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant    AbVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, userId])
  @@index([userId])
  @@map("ab_assignments")
}

// ============================================
// Pricing Rates (cost analytics)
// ============================================

// Tarifas de servicios externos para estimar costos en el panel de Analíticas.
// Historial inmutable: cuando se actualiza una tarifa se inserta una fila nueva
// con effectiveFrom=now() y se cierra la anterior con effectiveTo=now(). La
// tarifa "vigente" es la fila con isActive=true cuyo rango cubre el instante.
model PricingRate {
  id            String         @id @default(uuid())
  service       PricingService
  unit          PricingUnit
  unitPriceUsd  Decimal        @map("unit_price_usd") @db.Decimal(12, 6)
  currency      String         @default("USD")
  effectiveFrom DateTime       @default(now()) @map("effective_from")
  effectiveTo   DateTime?      @map("effective_to")
  isActive      Boolean        @default(true) @map("is_active")
  notes         String?
  createdBy     String?        @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([service, unit, isActive])
  @@index([effectiveFrom])
  @@map("pricing_rates")
}
