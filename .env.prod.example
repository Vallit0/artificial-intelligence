# =============================================================================
# Plantilla de variables para PRODUCCIÓN (capa_01). Copiar a server/.env y
# rellenar con valores reales. NO commitear server/.env.
#
#   cp .env.prod.example server/.env   &&   nano server/.env
#
# Generar secretos fuertes:
#   POSTGRES_PASSWORD:  openssl rand -base64 24
#   JWT_SECRET:         openssl rand -base64 48
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Usado por docker-compose.prod.yml para construir el DATABASE_URL hacia
# PgBouncer (apps) y hacia Postgres directo (job migrate). NO uses el viejo
# "senoriales/senoriales".
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Auth --------------------------------------------------------------------
# CRÍTICO: si esto falta, el server cae al default inseguro
# "senoriales-dev-secret-change-in-prod" y los JWT son falsificables.
JWT_SECRET=CHANGE_ME_long_random_secret

# --- App ---------------------------------------------------------------------
APP_URL=https://centro-de-negocios.org

# --- ElevenLabs --------------------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-default-agent-id
