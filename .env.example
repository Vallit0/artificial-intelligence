# ============================================
# Senoriales - Environment Variables
# ============================================
# Copy this file to server/.env and fill in your values

# Database
DATABASE_URL=postgresql://senoriales:CHANGE_ME@db:5432/senoriales

# Server
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://yourdomain.com
JWT_SECRET=GENERATE_WITH_openssl_rand_-base64_32
APP_URL=https://yourdomain.com

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-default-agent-id

# Agent IDs per mode (optional - can also be configured from Admin panel)
# ELEVENLABS_AGENT_COACH=
# ELEVENLABS_AGENT_ROLEPLAY_CLIENTE=
# ELEVENLABS_AGENT_ROLEPLAY_ASESOR=
# ELEVENLABS_AGENT_PROSPECTING_PAREJA=
# ELEVENLABS_AGENT_PROSPECTING_FRUTAS=
# ELEVENLABS_AGENT_PROSPECTING_NEUMATICOS=
# ELEVENLABS_AGENT_PROSPECTING_RESTAURANTE=
# ELEVENLABS_AGENT_PROSPECTING_PARQUEO=
# ELEVENLABS_AGENT_PROSPECTING_FAMILIA_STAND=
# ELEVENLABS_AGENT_PROSPECTING_PROFESIONAL_CAMINANDO=
# ELEVENLABS_AGENT_PROSPECTING_SENORA_COMPRAS_1=
# ELEVENLABS_AGENT_PROSPECTING_SENORA_COMPRAS_2=
# ELEVENLABS_AGENT_PROSPECTING_PAREJA_CEMENTERIO=
# ELEVENLABS_AGENT_PROSPECCION_FISICA=
# ELEVENLABS_AGENT_LEGADO_VIDA=
# ELEVENLABS_AGENT_EXAMEN_FINAL=
# ELEVENLABS_AGENT_EXAMEN_FINAL_NIVEL2=

# WHAPI (WhatsApp)
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_TOKEN=your-whapi-token

# Resend (email)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Senoriales <noreply@yourdomain.com>
